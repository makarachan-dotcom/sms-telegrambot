# ─────────────────────────────────────────────────────────────────────────────
# Environment configuration for the Infobip SMS Telegram Bot
# Copy this file to .env and fill in your real credentials.
# NEVER commit the real .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Telegram ────────────────────────────────────────────────────────────────
# Obtain from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ── Infobip ──────────────────────────────────────────────────────────────────
# Your unique Infobip base URL (e.g. abc123.api.infobip.com)
# Found in the Infobip portal: https://portal.infobip.com/dev/api-keys
INFOBIP_BASE_URL=your_base_url.api.infobip.com

# Your Infobip API key
INFOBIP_API_KEY=your_infobip_api_key_here

# ── Optional tuning ──────────────────────────────────────────────────────────
# Sender ID shown on the recipient's phone (alphanumeric, ≤11 chars, or a phone number)
INFOBIP_SENDER=InfoSMS

# Maximum SMS messages a single user may send per time window
RATE_LIMIT_MAX_MESSAGES=5

# Time window in seconds for the rate-limit counter
RATE_LIMIT_WINDOW_SECONDS=60

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
